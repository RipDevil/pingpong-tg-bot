# Obtain API credentials at https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Filled by npm run login; this grants access to your account.
TELEGRAM_SESSION=
# Copy a group ID from npm run chats (usually -100... for supergroups).
TELEGRAM_CHAT_ID=
TRIGGER_MESSAGE=ping
REPLY_MESSAGE=pong
# Random group-wide debounce; supports integer ms, s, m, or h durations.
REPLY_DELAY_MIN=1s
REPLY_DELAY_MAX=3s
